[Unit]
Description=Containerised GitHub Actions runner %i (ci-platform)
Wants=network-online.target
After=network-online.target user@@CI_UID@.service ci-egress.service
Requires=user@@CI_UID@.service ci-egress.service
# Every job is a restart, so never rate-limit them.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/ci-platform run %i
ExecStop=/usr/local/sbin/ci-platform stop %i
# Each container serves one job and exits; systemd immediately starts a fresh one.
Restart=always
RestartSec=3
# 78 = not registered yet: stay down until `ci-platform register` starts it.
RestartPreventExitStatus=78
TimeoutStopSec=11min

[Install]
WantedBy=multi-user.target
